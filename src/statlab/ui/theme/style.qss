/* Hoja de estilo de StatLab sobre el estilo base Fusion.
   Plantilla de string.Template: los marcadores con dólar se sustituyen por tokens.py. */

QWidget {
    color: ${text};
    font-size: ${font_size}px;
}

QMainWindow, QWidget#Central {
    background: ${bg};
}

QToolTip {
    background: ${panel};
    color: ${text};
    border: 1px solid ${border_strong};
    border-radius: ${radius_field}px;
    padding: 6px 8px;
}

/* --- Menús ------------------------------------------------------------ */
QMenuBar {
    background: ${panel};
    border-bottom: 1px solid ${border};
}
QMenuBar::item {
    padding: 4px 10px;
    background: transparent;
    border-radius: ${radius_field}px;
}
QMenuBar::item:selected {
    background: ${accent_soft};
}
QMenu {
    background: ${panel};
    border: 1px solid ${border_strong};
    border-radius: ${radius_button}px;
    padding: 4px;
}
QMenu::item {
    padding: 6px 24px 6px 24px;
    border-radius: ${radius_field}px;
}
QMenu::item:selected {
    background: ${accent_soft};
    color: ${text};
}
QMenu::separator {
    height: 1px;
    background: ${border};
    margin: 4px 8px;
}

/* --- Cabecera --------------------------------------------------------- */
QFrame#Header {
    background: ${panel};
    border: none;
    border-bottom: 1px solid ${border};
}
QLabel#AppTitle {
    font-size: 16px;
    font-weight: 700;
}
QLabel#ModuleName {
    color: ${text_secondary};
}
QFrame#OfflineBadge {
    background: ${done_soft};
    border-radius: 12px;
}
QFrame#OfflineBadge QLabel {
    color: ${done};
    font-size: 12px;
}

/* --- Botones ---------------------------------------------------------- */
QPushButton {
    background: ${panel};
    color: ${text};
    border: 1px solid ${border_strong};
    border-radius: ${radius_button}px;
    padding: 0px 14px;
    min-height: 34px;
    font-weight: 500;
}
QPushButton:hover {
    border-color: ${accent};
}
QPushButton:pressed {
    background: ${accent_soft};
}
QPushButton:disabled {
    color: ${text_muted};
    border-color: ${border};
}
QPushButton[variant="primary"] {
    background: ${accent};
    border-color: ${accent};
    color: ${accent_text};
}
QPushButton[variant="primary"]:hover {
    background: ${accent_hover};
    border-color: ${accent_hover};
}
QPushButton[variant="primary"]:disabled {
    background: ${border};
    border-color: ${border};
    color: ${text_muted};
}
QPushButton:focus {
    outline: none;
    border: 2px solid ${accent};
}

/* --- Barra lateral ---------------------------------------------------- */
QScrollArea#Sidebar, QWidget#SidebarContent {
    background: ${sidebar};
    border: none;
}
QScrollArea#Sidebar {
    border-right: 1px solid ${border};
}
QLabel#SidebarTitle {
    color: ${text_secondary};
    font-size: 12px;
    font-weight: 600;
    padding: 2px 4px;
}

QFrame#StepCard {
    background: ${panel};
    border: 1px solid ${border};
    border-radius: ${radius_card}px;
}
QFrame#StepCard[state="active"] {
    border: 2px solid ${accent};
}
QFrame#StepCard[state="stale"] {
    border: 1px solid ${stale};
    background: ${stale_soft};
}
QFrame#StepCard[state="pending"] {
    background: transparent;
}
QFrame#StepCard QLabel#StepTitle {
    font-size: 14px;
    font-weight: 600;
}
QFrame#StepCard[state="pending"] QLabel#StepTitle {
    color: ${text_muted};
    font-weight: 500;
}
QFrame#StepCard QLabel#StepSummary {
    color: ${text_secondary};
    font-size: 12px;
}
QFrame#StepCard[state="pending"] QLabel#StepSummary {
    color: ${text_muted};
}

QLabel#StepBadge {
    border-radius: 11px;
    font-size: 12px;
    font-weight: 700;
    color: ${accent_text};
    background: ${accent};
}
QLabel#StepBadge[state="done"] {
    background: ${done};
}
QLabel#StepBadge[state="stale"] {
    background: ${stale};
}
QLabel#StepBadge[state="pending"] {
    background: transparent;
    color: ${text_muted};
    border: 1px solid ${pending_ring};
    font-weight: 600;
}

/* --- Zona central ----------------------------------------------------- */
QFrame#Panel {
    background: ${panel};
    border: 1px solid ${border};
    border-radius: ${radius_panel}px;
}
QLabel#EmptyTitle {
    font-size: 18px;
    font-weight: 600;
}
QLabel#EmptyBody {
    color: ${text_secondary};
}
QLabel#Muted {
    color: ${text_muted};
}

QSplitter::handle {
    background: transparent;
}
QSplitter::handle:hover {
    background: ${accent_soft};
}

/* --- Barras de desplazamiento ---------------------------------------- */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}
QScrollBar::handle {
    background: ${border_strong};
    border-radius: 3px;
    min-height: 24px;
    min-width: 24px;
}
QScrollBar::handle:hover {
    background: ${text_muted};
}
QScrollBar::add-line, QScrollBar::sub-line {
    width: 0px;
    height: 0px;
}
QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

/* --- Tabla de datos -------------------------------------------------- */
QLabel#DataTitle {
    font-weight: 600;
}
QLabel#NaBadge {
    color: ${na_text};
    background: ${na_bg};
    border-radius: ${radius_chip}px;
    padding: 2px 8px;
    font-size: 12px;
}
QTableView#DataTable {
    background: ${panel};
    alternate-background-color: ${panel};
    border: none;
    border-top: 1px solid ${border};
    gridline-color: ${gridline};
    selection-background-color: ${selection};
    selection-color: ${text};
}

/* Barras flotantes */
QFrame#FloatBarColumns {
    background: ${float_dark_bg};
    border-radius: ${radius_card}px;
}
QFrame#FloatBarColumns QLabel#FloatCount {
    color: ${float_dark_fg};
    font-weight: 600;
}
QFrame#FloatBarColumns QPushButton#FloatButton {
    background: transparent;
    color: ${float_dark_fg};
    border: 1px solid transparent;
    min-height: 30px;
    padding: 0px 10px;
}
QFrame#FloatBarColumns QPushButton#FloatButton:hover {
    background: rgba(255, 255, 255, 0.14);
}
QFrame#FloatBarRows {
    background: ${float_rows_bg};
    border: 1px solid ${stale};
    border-radius: ${radius_card}px;
}
QFrame#FloatBarRows QLabel#FloatCount {
    color: ${float_rows_fg};
    font-weight: 600;
}
QFrame#FloatBarRows QPushButton#FloatButton {
    background: transparent;
    color: ${float_rows_fg};
    border: 1px solid transparent;
    min-height: 30px;
    padding: 0px 10px;
}
QFrame#FloatBarRows QPushButton#FloatButton:hover {
    background: rgba(154, 103, 0, 0.14);
}
QLabel#Toast {
    background: ${toast_bg};
    color: ${toast_fg};
    border: 1px solid ${stale};
    border-radius: ${radius_button}px;
    padding: 10px 14px;
}

/* --- Paso «Variables y filas» ---------------------------------------- */
QLabel#FieldLabel {
    color: ${text_secondary};
    font-size: 12px;
    font-weight: 500;
}
QLabel#RoleChip {
    font-size: 11px;
    font-weight: 600;
    border-radius: ${radius_chip}px;
    padding: 2px 6px;
}
QLabel#RoleChip[role="model"] {
    background: ${role_model_bg};
    color: ${role_model_fg};
}
QLabel#RoleChip[role="descr"] {
    background: ${role_descr_bg};
    color: ${role_descr_fg};
}
QLabel#Hint {
    color: ${text_muted};
    font-size: 12px;
}
QPushButton#LinkButton {
    background: transparent;
    border: none;
    color: ${accent};
    padding: 0px;
    min-height: 0px;
    text-align: left;
    font-size: 12px;
}
QPushButton#LinkButton:hover {
    color: ${accent_hover};
    text-decoration: underline;
}

/* --- Controles de los pasos ------------------------------------------ */
QComboBox, QSpinBox {
    background: ${panel};
    color: ${text};
    border: 1px solid ${border_strong};
    border-radius: ${radius_field}px;
    padding: 4px 8px;
    min-height: 22px;
}
QComboBox:hover, QSpinBox:hover {
    border-color: ${accent};
}
QComboBox:focus, QSpinBox:focus {
    border: 2px solid ${accent};
}
QComboBox QAbstractItemView {
    background: ${panel};
    color: ${text};
    border: 1px solid ${border_strong};
    selection-background-color: ${accent_soft};
    selection-color: ${text};
}
QToolButton#HelpButton {
    background: transparent;
    color: ${text_muted};
    border: 1px solid ${pending_ring};
    border-radius: 9px;
    font-size: 11px;
    font-weight: 600;
    padding: 0px;
}
QToolButton#HelpButton:hover {
    color: ${accent};
    border-color: ${accent};
}
QLabel#StepResult {
    color: ${text_secondary};
    font-size: 12px;
}
QLabel#WarningNote, QLabel#StaleNote {
    color: ${stale};
    font-size: 12px;
}
QLabel#ValidationNote {
    color: ${na_text};
    font-size: 12px;
}
QProgressBar#StepProgress {
    background: ${gridline};
    border: none;
    border-radius: 3px;
}
QProgressBar#StepProgress::chunk {
    background: ${accent};
    border-radius: 3px;
}
QComboBox {
    padding-right: 24px;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 22px;
    border: none;
}
QComboBox::down-arrow {
    image: url(statlab:icons/chevron-down-${mode}.svg);
    width: 10px;
    height: 6px;
}
QSpinBox {
    padding-right: 22px;
}
QSpinBox::up-button, QSpinBox::down-button {
    subcontrol-origin: border;
    width: 20px;
    border: none;
    background: transparent;
}
QSpinBox::up-button {
    subcontrol-position: top right;
}
QSpinBox::down-button {
    subcontrol-position: bottom right;
}
QSpinBox::up-arrow {
    image: url(statlab:icons/chevron-up-${mode}.svg);
    width: 10px;
    height: 6px;
}
QSpinBox::down-arrow {
    image: url(statlab:icons/chevron-down-${mode}.svg);
    width: 10px;
    height: 6px;
}
QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background: ${accent_soft};
}

/* --- Panel de resultados --------------------------------------------- */
QScrollArea#ResultsScroll, QWidget#ResultsContent {
    background: ${panel};
    border: none;
    border-radius: ${radius_panel}px;
}
QLabel#StaleBanner {
    background: ${stale_soft};
    color: ${stale};
    border-bottom: 1px solid ${stale};
    border-top-left-radius: ${radius_panel}px;
    border-top-right-radius: ${radius_panel}px;
    padding: 8px 16px;
    font-size: 12px;
}
QLabel#SectionTitle {
    font-weight: 600;
}
QLabel#KChip {
    background: ${accent_soft};
    color: ${role_model_fg};
    border-radius: 11px;
    padding: 3px 10px;
    font-size: 12px;
    font-weight: 500;
}
QFrame#ChartBox {
    background: ${panel};
    border: 1px solid ${border};
    border-radius: ${radius_card}px;
}
QLabel#ChartTitle {
    font-weight: 600;
    color: ${text};
}
QFrame#InfoCard {
    background: ${accent_soft};
    border: 1px solid ${border};
    border-radius: ${radius_card}px;
}
QTableWidget#IndexTable {
    background: ${panel};
    border: 1px solid ${border};
    border-radius: ${radius_field}px;
    gridline-color: ${gridline};
}
QTableWidget#IndexTable QHeaderView::section {
    background: ${header_cell};
    color: ${text_secondary};
    border: none;
    border-bottom: 1px solid ${border};
    padding: 5px 8px;
    font-weight: 600;
    font-size: 12px;
}

/* --- Modelo final ---------------------------------------------------- */
QFrame#KpiCard {
    background: ${panel};
    border: 1px solid ${border};
    border-radius: ${radius_card}px;
}
QLabel#KpiTitle {
    color: ${text_secondary};
    font-size: 12px;
    font-weight: 500;
}
QLabel#KpiValue {
    font-size: 22px;
    font-weight: 600;
    color: ${text};
}
QLabel#KpiNote {
    color: ${text_muted};
    font-size: 11px;
}
QLabel#SizesLine {
    color: ${text_secondary};
}
QTabWidget#ResultTabs::pane {
    border: none;
    border-top: 1px solid ${border};
}
QTabWidget#ResultTabs QTabBar::tab {
    background: transparent;
    color: ${text_secondary};
    padding: 8px 14px;
    border: none;
    border-bottom: 2px solid transparent;
    font-weight: 500;
}
QTabWidget#ResultTabs QTabBar::tab:selected {
    color: ${text};
    border-bottom: 2px solid ${accent};
    font-weight: 600;
}
QTabWidget#ResultTabs QTabBar::tab:hover {
    color: ${accent};
}
QPushButton#HighlightButton {
    min-height: 24px;
    padding: 0px 10px;
    border-radius: 12px;
    font-size: 12px;
}
QPushButton#HighlightButton:checked {
    background: ${accent_soft};
    border-color: ${accent};
    color: ${text};
}

/* --- Exportar --------------------------------------------------------- */
QPushButton#ExportButton {
    text-align: left;
    padding: 0px 12px;
    min-height: 30px;
}

/* --- Modo «Preparar datos» ------------------------------------------- */
QFrame#ModeSwitch {
    background: ${gridline};
    border-radius: ${radius_button}px;
}
QPushButton#ModeButton {
    background: transparent;
    border: none;
    color: ${text_secondary};
    padding: 5px 12px;
    min-height: 0px;
    font-weight: 500;
}
QPushButton#ModeButton:hover {
    color: ${text};
}
QPushButton#ModeButton:checked {
    background: ${panel};
    color: ${text};
    font-weight: 600;
}
QFrame#ListRow {
    border-top: 1px solid ${border};
    border-radius: 0px;
}
QFrame#ListRow:hover {
    background: ${bg};
}
QLabel#SeverityDot {
    border-radius: 4px;
    background: ${text_muted};
}
QLabel#SeverityDot[level="grave"] {
    background: ${na_text};
}
QLabel#SeverityDot[level="aviso"] {
    background: ${stale};
}
QLabel#RowText {
    font-size: 13px;
    color: ${text};
}
QLabel#RowStatus, QLabel#RowNumber {
    font-size: 12px;
    color: ${text_muted};
}
QLabel#RowError {
    font-size: 12px;
    color: ${na_text};
}
QFrame#ListRow[state="off"] QLabel#RowText {
    color: ${text_muted};
}
QFrame#ListRow[state="error"] QLabel#RowText {
    color: ${na_text};
}
QToolButton#RowMenu {
    background: transparent;
    color: ${text_secondary};
    border: none;
    border-radius: 4px;
    padding: 0px 4px;
    font-size: 15px;
    font-weight: 700;
}
QToolButton#RowMenu:hover {
    background: ${gridline};
    color: ${text};
}
QLabel#OkNote {
    color: ${done};
    font-size: 12px;
    font-weight: 500;
}
QLineEdit, QPlainTextEdit {
    background: ${panel};
    color: ${text};
    border: 1px solid ${border_strong};
    border-radius: ${radius_field}px;
    padding: 4px 6px;
    selection-background-color: ${accent_soft};
    selection-color: ${text};
}
QLineEdit:focus, QPlainTextEdit:focus {
    border: 2px solid ${accent};
}
QPlainTextEdit#FormulaEdit, QLabel#FormulaText {
    font-family: "DejaVu Sans Mono", "Consolas", "Menlo", monospace;
}
QScrollArea#FlowScroll, QScrollArea#FlowScroll > QWidget > QWidget {
    background: transparent;
}
